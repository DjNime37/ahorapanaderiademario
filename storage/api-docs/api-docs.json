{
    "openapi": "3.0.0",
    "info": {
        "title": "MarioBakery API",
        "description": "Documentación interactiva de la API para MarioBakery",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Servidor Local"
        }
    ],
    "paths": {
        "/api/productos": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Lista de productos",
                "description": "Devuelve todos los productos disponibles en la panaderia",
                "operationId": "786d74243fbf30dace82b25a638113b4",
                "responses": {
                    "200": {
                        "description": "Operación exitosa",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Producto"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/productos/{id}": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Consultar producto",
                "description": "Devuelve un producto según su identificador",
                "operationId": "d82fcf54a61b41d79fee46cb397bddab",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Producto encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Producto"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Producto no encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Producto no encontrado"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Categoria": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "descripcion": {
                        "type": "string",
                        "nullable": true
                    },
                    "imagen": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Producto": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "descripcion": {
                        "type": "string",
                        "nullable": true
                    },
                    "precio": {
                        "type": "number",
                        "format": "float"
                    },
                    "precio_formateado": {
                        "type": "string"
                    },
                    "imagen": {
                        "type": "string",
                        "nullable": true
                    },
                    "disponible": {
                        "type": "boolean"
                    },
                    "categoria_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "categoria": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Categoria"
                            },
                            {
                                "type": "object",
                                "nullable": true,
                                "enum": [
                                    null
                                ]
                            }
                        ]
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Productos",
            "description": "Productos"
        }
    ]
}